# Required — EVM private key of the intent signer registered in the bridge adapter.
# On testnet this is the deployer key. Set in adapter via setIntentSigner(xrplAccount, signerAddress).
DEPLOYER_PRIVATE_KEY=0x<your-evm-private-key>

# Required for market history indexing. Use a SEPARATE database per network
# (testnet vs mainnet) — snapshots are keyed by chain_id, but separate DBs keep
# the two environments fully isolated.
POSTGRES_CONNECTIONSTRING=postgres://<user>:<password>@<host>/<database>?sslmode=require
CRON_SECRET=<random-secret-used-by-market-snapshot-cron>

# XRPL EVM network — defaults to testnet (chain id 1449000) when unset.
# For mainnet set chain id 1440000 and the mainnet RPC.
NEXT_PUBLIC_XRPL_EVM_CHAIN_ID=1449000
NEXT_PUBLIC_XRPL_EVM_RPC_URL=https://rpc.testnet.xrplevm.org

# Deployed contract addresses — default to the testnet deployment when unset.
# Override all of these for a mainnet deployment.
NEXT_PUBLIC_COMPTROLLER_ADDRESS=0x46d364257112230022E72b086Df85a6b0f8D3F86
NEXT_PUBLIC_ORACLE_ADDRESS=0x517475AFaFfaE71491d9Bad598E07AAFD050Ca80
NEXT_PUBLIC_INTEREST_RATE_MODEL_ADDRESS=0xDd31C1db90AB0b094d73E0b4c8dae2296a7d8C0d
NEXT_PUBLIC_PROXY_FACTORY_ADDRESS=0xB7f3ECe856063F48BC3bcC7A381aE875841663aA
NEXT_PUBLIC_BRIDGE_ADAPTER_ADDRESS=0x7AC8Df85448037c6fE1eD5732c6ca71060069237
NEXT_PUBLIC_LIQUIDATION_KEEPER_ADDRESS=0xF87Bda7207B629789abaaCcef366Ba853BA11399

# Optional — mainnet-only features (Squid liquidity bridge + advanced strategies
# planner). Hidden on testnet by default (shown only when chain id = 1440000).
# Force on/off regardless of chain id: true | false.
NEXT_PUBLIC_MAINNET_FEATURES=

# Required — WalletConnect project ID (HyperGate wallet connector)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<your-walletconnect-project-id>

# Optional — Xumm API key for the Xumm connector
NEXT_PUBLIC_XUMM_API_KEY=<your-xumm-api-key>

# Optional — Axelar routing for XRPL → XRPL EVM bridging.
# Defaults to the current XRPL EVM testnet deployment when unset.
NEXT_PUBLIC_XRPL_AXELAR_GATEWAY=rNrjh1KGZk2jBR3wPfAQnoidtFFYQKbQn2
NEXT_PUBLIC_AXELAR_DESTINATION_CHAIN=xrpl-evm

# Optional — block explorer base URLs (no trailing slash). Default to the
# testnet/mainnet explorer based on the chain id; override only to pin a value.
NEXT_PUBLIC_EXPLORER_XRPL_EVM=https://explorer.testnet.xrplevm.org
NEXT_PUBLIC_EXPLORER_XRPL_LEDGER=https://testnet.xrpl.org
NEXT_PUBLIC_AXELARSCAN_URL=https://testnet.axelarscan.io
NEXT_PUBLIC_AXELARSCAN_API_URL=https://testnet.api.axelarscan.io

# Optional — Squid bridge entry point for EVM users.
# Squid's public XRPL EVM destination is mainnet chain ID 1440000.
NEXT_PUBLIC_SQUID_APP_URL=https://apiplus.squidrouter.com/
NEXT_PUBLIC_SQUID_DESTINATION_CHAIN_ID=1440000
NEXT_PUBLIC_SQUID_DEFAULT_SOURCE_CHAIN_ID=1
NEXT_PUBLIC_SQUID_DEFAULT_SOURCE_TOKEN=0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee

# Optional — paste a Widget Studio iframe URL to render the hosted widget in-app.
# When unset, the UI falls back to a prefilled Squid app URL.
NEXT_PUBLIC_SQUID_WIDGET_IFRAME_URL=
